{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && node --env-file-if-exists=.env.local dist/server.js",
    "dev:vercel": "vercel dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.1",
    "@scalar/hono-api-reference": "^0.12.0",
    "@types/node": "^26.4.0",
    "hono": "^4.13.5",
    "undici": "^8.10.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
