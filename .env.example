# Key that callers must send as the x-api-key header. Required unless DISABLE_AUTH=true.
API_KEY=
# Local-only escape hatch: skips the API key check. Never set this in a deployment.
DISABLE_AUTH=

# LinkedIn session cookie copied from a logged-in browser. Primary auth path.
LI_AT=
# Optional. Any value works; one is generated per request when this is unset.
LI_JSESSIONID=

# Optional fallback: used only if LI_AT is missing or rejected.
# Preferred over LI_AT: the whole Cookie header from a signed-in browser, copied from any
# www.linkedin.com request in DevTools. Sessions sent as li_at alone get revoked quickly.
LI_COOKIE=

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional. Fills the API key into /docs so the endpoint is callable from the page. Anyone who
# can reach /docs can then read the key, so leave it off unless the deployment is meant to be open.
DOCS_PREFILL_API_KEY=

# Optional. Enables the secondary GraphQL source; captured from DevTools, see README.
VOYAGER_PROFILE_QUERY_ID=

# Optional. Egress proxy, if LinkedIn challenges the host's datacenter IP.
PROXY_URL=

CACHE_TTL_SECONDS=3600
# Degraded (public-page) answers expire faster, so a transient block is not served for an hour.
PARTIAL_CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=30
HTTP_TIMEOUT_MS=15000
